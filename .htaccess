# ToolzMoolz — canonical URLs and legacy redirects
# Served by Apache / LiteSpeed on shared hosting.
# Every rule is guarded by <IfModule> so the file is inert if mod_rewrite is missing.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Canonical host.
  RewriteCond %{HTTP_HOST} ^www\.toolzmoolz\.com$ [NC]
  RewriteRule ^(.*)$ https://toolzmoolz.com/$1 [R=301,L]

  # 2) Redirect search/query variants to homepage (fixes ?q={search_term_string})
  RewriteCond %{QUERY_STRING} ^q= [NC]
  RewriteRule ^$ / [R=301,L,QSD]

  # 3) Root index.html → /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 4) Directory index.html → directory/
  RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
  RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]

  # 5) Other .html → remove .html
  RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !index\.html$ [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # 6) Legacy removed URL
  RewriteRule ^seo-toolkit/backlink-analyzer/?$ /keyword-spinner/ [R=301,L]

  # 7) Serve .html for extensionless paths (root files)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)$ $1.html [L]

  # 8) Redirect any non-existent pages to homepage
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html !-f
  RewriteRule ^(.*)$ / [R=301,L]
</IfModule>
